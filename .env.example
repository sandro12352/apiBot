PORT=3000
PUBLIC_PATH=public

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# Orígenes permitidos para CORS, separados por comas
CORS_ORIGINS=http://localhost:5173

# Rate limit global por IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Tamaño máximo del body JSON
JSON_BODY_LIMIT=1mb

DATABASE_URL="postgresql://chatbot:chatbot12352*@localhost:5432/chatbotBd?schema=public"

POSTGRES_USER=chatbot
POSTGRES_DB=chatbotBd
POSTGRES_PORT=5432
POSTGRES_PASSWORD=chatbot12352*


NODE_ENV=development


# Redis (cola de trabajos futura; BullMQ aún no es decisión definitiva)
REDIS_URL=redis://localhost:6379
# Sesiones: access token JWT corto + refresh token (se guarda solo su hash en BD)
# JWT_SECRET: usa un secreto largo y aleatorio
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# Fuerza bruta: bloqueo temporal de la cuenta tras N intentos fallidos
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Rate limit estricto por IP en /auth (login, refresh, correos)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Saltos de proxy inverso delante de la app (1 = un Nginx/Caddy)
TRUST_PROXY=1

# Correo (verificación y recuperación). Sin SMTP_HOST se imprime en consola.
APP_URL=http://localhost:3000
MAIL_FROM=no-reply@tudominio.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Registro público (POST /auth/register). Apagado: el alta de clientes es manual.
ALLOW_PUBLIC_REGISTER=false

# Nombre del producto que aparece en los correos
APP_NAME=Tu plataforma
