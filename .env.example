PORT=3000
PUBLIC_PATH=public

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# Orígenes permitidos para CORS, separados por comas
CORS_ORIGINS=http://localhost:5173

# Rate limit global por IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Tamaño máximo del body JSON
JSON_BODY_LIMIT=1mb

DATABASE_URL="postgresql://chatbot:chatbot12352*@localhost:5432/chatbotBd?schema=public"

POSTGRES_USER=chatbot
POSTGRES_DB=chatbotBd
POSTGRES_PORT=5432
POSTGRES_PASSWORD=chatbot12352*


NODE_ENV=development


# Redis (cola de trabajos futura; BullMQ aún no es decisión definitiva)
REDIS_URL=redis://localhost:6379
# JWT (usa un secreto largo y aleatorio)
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Correo (verificación y recuperación). Sin SMTP_HOST se imprime en consola.
APP_URL=http://localhost:3000
MAIL_FROM=no-reply@tudominio.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Registro público (POST /auth/register). Apagado: el alta de clientes es manual.
ALLOW_PUBLIC_REGISTER=false
